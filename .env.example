# ============================================================
# SONIC RIDER web — environment variables (EXAMPLE ONLY)
# Copy to .env.local and fill in real values.
# NEVER commit .env.local (it is git-ignored).
# ============================================================

# Public site URL — will be used by canonical URLs, sitemap.xml and
# Open Graph tags (SEO milestone). Placeholder until the domain is
# decided — see docs/BRAND.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# WordPress CMS (FUTURE — Week 03+ milestone, not used yet).
# Server-side only: values WITHOUT the NEXT_PUBLIC_ prefix never
# reach the browser bundle.
# ------------------------------------------------------------
# WP_API_URL=http://sonic-rider-local.local/wp-json
# WP_API_USER=
# WP_API_PASSWORD=
